rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Pillar 0: Global Default-Deny Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Phase 3: Global Hardened Primitives
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isVerifiedUser() && request.auth.uid == userId;
    }

    function hasActiveParentUser(userId) {
      return exists(/databases/$(database)/documents/users/$(userId))
        && get(/databases/$(database)/documents/users/$(userId)).data.uid == request.auth.uid;
    }

    // Pillar 2: Validation Blueprints (Synchronized verbatim with firebase-blueprint.json)
    function isValidUserProfile(data, userId) {
      return data.keys().hasAll([
          'uid',
          'displayName',
          'email',
          'photoURL',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'uid',
          'displayName',
          'email',
          'photoURL',
          'createdAt',
          'updatedAt'
        ])
        && data.uid is string
        && isValidId(data.uid)
        && data.uid == request.auth.uid
        && data.uid == userId
        && data.displayName is string
        && data.displayName.size() >= 1
        && data.displayName.size() <= 120
        && data.email is string
        && data.email.size() >= 3
        && data.email.size() <= 254
        && data.email == request.auth.token.email
        && data.photoURL is string
        && data.photoURL.size() <= 512
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidDraftStatus(status) {
      return status is string
        && status.size() >= 1
        && status.size() <= 32
        && (status == 'READY_TO_SPIN' || status == 'PICKING_PLAYER' || status == 'COMPLETED');
    }

    function isValidGameSave(data, userId) {
      return data.keys().hasAll([
          'ownerUid',
          'schemaVersion',
          'franchiseName',
          'squadCount',
          'draftStatus',
          'settings',
          'draft',
          'playingXi',
          'career',
          'season',
          'activeMatch',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'ownerUid',
          'schemaVersion',
          'franchiseName',
          'squadCount',
          'draftStatus',
          'settings',
          'draft',
          'playingXi',
          'career',
          'season',
          'activeMatch',
          'createdAt',
          'updatedAt'
        ])
        && data.ownerUid is string
        && isValidId(data.ownerUid)
        && data.ownerUid == request.auth.uid
        && data.ownerUid == userId
        && data.schemaVersion is int
        && data.schemaVersion >= 1
        && data.schemaVersion <= 100
        && data.franchiseName is string
        && data.franchiseName.size() >= 1
        && data.franchiseName.size() <= 80
        && data.squadCount is int
        && data.squadCount >= 0
        && data.squadCount <= 30
        && isValidDraftStatus(data.draftStatus)
        && data.settings is map
        && data.draft is map
        && data.playingXi is map
        && data.career is map
        && (data.season == null || data.season is map)
        && (data.activeMatch == null || data.activeMatch is map)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    // Collection 1: Owner-only private user profile (PII isolated)
    match /users/{userId} {
      allow list: if false;

      allow get: if isOwner(userId)
        && isValidId(userId);

      allow create: if isOwner(userId)
        && isValidId(userId)
        && isValidUserProfile(incoming(), userId)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isOwner(userId)
        && isValidId(userId)
        && isValidUserProfile(incoming(), userId)
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          incoming().diff(existing()).affectedKeys().hasOnly([
            'displayName',
            'email',
            'photoURL',
            'updatedAt'
          ])
        );

      allow delete: if false;

      // Collection 2: Owner-only cloud game save (Master Gate verifies parent user doc)
      match /gameSaves/{saveId} {
        allow list: if false;

        allow get: if isOwner(userId)
          && isValidId(userId)
          && isValidId(saveId)
          && hasActiveParentUser(userId);

        allow create: if isOwner(userId)
          && isValidId(userId)
          && isValidId(saveId)
          && isValidGameSave(incoming(), userId)
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time
          && hasActiveParentUser(userId);

        allow update: if isOwner(userId)
          && isValidId(userId)
          && isValidId(saveId)
          && isValidGameSave(incoming(), userId)
          && incoming().ownerUid == existing().ownerUid
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && (
            incoming().diff(existing()).affectedKeys().hasOnly([
              'schemaVersion',
              'franchiseName',
              'squadCount',
              'draftStatus',
              'settings',
              'draft',
              'playingXi',
              'career',
              'season',
              'activeMatch',
              'updatedAt'
            ])
          )
          && hasActiveParentUser(userId);

        allow delete: if isOwner(userId)
          && isValidId(userId)
          && isValidId(saveId)
          && hasActiveParentUser(userId);
      }
    }
  }
}
